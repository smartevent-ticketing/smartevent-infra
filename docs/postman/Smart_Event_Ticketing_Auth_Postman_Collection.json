{
	"info": {
		"_postman_id": "7f8b9e1a-5d2c-4f3e-9a1b-8c2d3e4f5a6b",
		"name": "Smart Event Ticketing Platform - Module Identity & Auth",
		"description": "Bộ Postman Collection hoàn chỉnh kiểm thử toàn bộ API Module Identity & Authentication (Register, Login, Token Rotation, Profile, Logout, Error Scenarios). Có sẵn script tự động bắt và lưu Access Token, Refresh Token vào Environment.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Authentication Flow (Happy Path)",
			"item": [
				{
					"name": "1. Đăng ký tài khoản (Register)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"customer{{$timestamp}}@example.com\",\n    \"password\": \"Password@123\",\n    \"fullName\": \"Nguyen Van A\",\n    \"phone\": \"0901234567\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Đăng ký tài khoản khách hàng mới với vai trò mặc định là CUSTOMER."
					},
					"response": []
				},
				{
					"name": "2. Đăng nhập (Login - Auto Save Tokens)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    pm.environment.set(\"currentUserId\", jsonData.data.user.id);",
									"    console.log(\"✅ Đã tự động lưu accessToken và refreshToken vào Environment!\");",
									"}",
									"pm.test(\"Đăng nhập thành công trả về 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.data.refreshToken).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Đăng nhập bằng Email và Password. Khi đăng nhập thành công, Test Script sẽ tự động gán `accessToken` và `refreshToken` vào biến môi trường."
					},
					"response": []
				},
				{
					"name": "3. Lấy thông tin tài khoản hiện tại (/me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Lấy profile thành công trả về 200 OK\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(200);",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.email).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{accessToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						},
						"description": "Gọi endpoint /me yêu cầu Bearer Access Token lấy thông tin cá nhân và danh sách vai trò."
					},
					"response": []
				},
				{
					"name": "4. Xoay vòng Refresh Token (Token Rotation)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"    pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"    console.log(\"🔄 Đã xoay vòng và cập nhật cặp Token mới vào Environment!\");",
									"}",
									"pm.test(\"Cấp mới token thành công trả về 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.data.refreshToken).to.be.a('string');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/refresh-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"refresh-token"
							]
						},
						"description": "Gửi Refresh Token hiện tại lên để thu hồi token cũ và nhận cặp Access Token + Refresh Token hoàn toàn mới."
					},
					"response": []
				},
				{
					"name": "5. Đăng xuất (Logout)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Đăng xuất thành công trả về 200 OK\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(200);",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"logout"
							]
						},
						"description": "Gửi Refresh Token để thu hồi (revoked_at = NOW()) trong database."
					},
					"response": []
				}
			]
		},
		{
			"name": "02. Error & Security Test Cases",
			"item": [
				{
					"name": "2.1. Đăng nhập sai mật khẩu (401 INVALID_CREDENTIALS)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Sai mật khẩu trả về 401 UNAUTHORIZED\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(401);",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.code).to.eql(\"INVALID_CREDENTIALS\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"SaiMatKhau@999\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.2. Đăng ký email bị trùng lặp (400 DUPLICATE_EMAIL)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Trùng email trả về 400 BAD REQUEST\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(400);",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.code).to.eql(\"DUPLICATE_EMAIL\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"testuser@example.com\",\n    \"password\": \"Password@123\",\n    \"fullName\": \"Nguyen Van A\",\n    \"phone\": \"0901234567\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.3. Gọi API bảo mật không kèm Token (401 UNAUTHORIZED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Không có token trả về 401 UNAUTHORIZED do EntryPoint xử lý\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(401);",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.code).to.eql(\"UNAUTHORIZED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						}
					},
					"response": []
				},
				{
					"name": "2.4. Gọi API với Token giả mạo hoặc sai chữ ký (401 UNAUTHORIZED)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Token giả mạo bị Filter chặn và trả về 401\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.response.to.have.status(401);",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.code).to.eql(\"UNAUTHORIZED\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJmYWtlLXV1aWQifQ.fake_signature",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}
