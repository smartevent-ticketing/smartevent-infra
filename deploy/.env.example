# Three DNS A records must point to the VPS before starting Caddy.
APP_DOMAIN=demo.example.com
MEDIA_DOMAIN=media.example.com
PORTFOLIO_DOMAIN=portfolio.example.com
CADDYFILE=Caddyfile.portfolio

POSTGRES_DB=smartevent
POSTGRES_USER=smartevent
POSTGRES_PASSWORD=replace_with_unique_database_password

RABBITMQ_DEFAULT_USER=smartevent
RABBITMQ_DEFAULT_PASS=replace_with_unique_rabbitmq_password

MINIO_ROOT_USER=smartevent
MINIO_ROOT_PASSWORD=replace_with_unique_minio_password
APP_MINIO_BUCKET=smart-event-bucket

# Generate at least 32 random bytes encoded as Base64, for example openssl rand -base64 32.
JWT_SECRET=replace_with_base64_encoded_random_jwt_secret

# Leave blank until a VNPay sandbox merchant and public callback are configured.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
