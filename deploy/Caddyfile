{$APP_DOMAIN} {
    @backend path /api/v1/*
    handle @backend {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:3000
    }
}

{$MEDIA_DOMAIN} {
    @download method GET HEAD
    handle @download {
        reverse_proxy minio:9000
    }
    handle {
        respond 405
    }
}

{$PORTFOLIO_DOMAIN} {
    root * /srv/portfolio
    encode zstd gzip
    file_server
}
