# Local development only. Copy this file to .env and change all *_PASSWORD values.
INFRA_BIND_ADDRESS=127.0.0.1

# PostgreSQL
POSTGRES_DB=smart_event_db
POSTGRES_USER=smartevent
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=smartevent
RABBITMQ_DEFAULT_PASS=change_me_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ROOT_USER=smartevent
MINIO_ROOT_PASSWORD=change_me_local_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
