# ==============================================================================
# SMART EVENT TICKETING PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Hướng dẫn: Tạo file .env tại thư mục gốc và sao chép toàn bộ nội dung từ file này sang,
# sau đó thay đổi các giá trị theo môi trường thực tế của bạn.

# ==============================================================================
# 1. DATABASE & DOCKER (PostgreSQL 16)
# ==============================================================================
POSTGRES_DB=smart_event_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_event_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# ==============================================================================
# 2. JWT SECURITY (Identity Module)
# ==============================================================================
# Khóa bí mật băm HMAC-SHA256 cho Token (Tối thiểu 256-bit / 64 ký tự Hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Thời gian sống Access Token: 900.000 ms = 15 phút
JWT_ACCESS_EXPIRATION=900000
# Thời gian sống Refresh Token: 604.800.000 ms = 7 ngày
JWT_REFRESH_EXPIRATION=604800000

# ==============================================================================
# 3. MESSAGE BROKER (RabbitMQ)
# ==============================================================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ==============================================================================
# 4. OBJECT STORAGE (MinIO)
# ==============================================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
APP_MINIO_ENDPOINT=http://localhost:9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_BUCKET=smart-event-bucket

# ==============================================================================
# 5. CỔNG THANH TOÁN VNPAY (Sandbox)
# ==============================================================================
# Thông tin lấy từ email VNPay gửi sau khi đăng ký trên sandbox.vnpayment.vn/devreg
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# ==============================================================================
# 6. VÍ ĐIỆN TỬ MOMO (Sandbox Test Credentials)
# ==============================================================================
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX0huZDAm&8fStatic
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:8080/api/v1/payments/momo/return
MOMO_IPN_URL=http://localhost:8080/api/v1/payments/momo/ipn

# ==============================================================================
# 7. VÍ ĐIỆN TỬ ZALOPAY (Sandbox Test Credentials)
# ==============================================================================
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=PcY4iZIKrnbtLENg5BQvdEwDuKjvMwdu
ZALOPAY_KEY2=kLtgPl8HHhfvMuY2tcKbgFn9pInnFUba
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=http://localhost:8080/api/v1/payments/zalopay/callback

# ==============================================================================
# 8. CỔNG THANH TOÁN PAYPAL (Sandbox)
# ==============================================================================
# Thông tin lấy từ developer.paypal.com -> Apps & Credentials -> Sandbox App
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_SECRET_KEY=YOUR_PAYPAL_SECRET_KEY
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8080/api/v1/payments/paypal/success
PAYPAL_CANCEL_URL=http://localhost:8080/api/v1/payments/paypal/cancel

# ==============================================================================
# 9. GỬI EMAIL THÔNG BÁO & HÓA ĐƠN (Gmail SMTP / SendGrid)
# ==============================================================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
# Mật khẩu ứng dụng 16 ký tự tạo tại: https://myaccount.google.com/apppasswords
SPRING_MAIL_PASSWORD=your_16_digit_google_app_password